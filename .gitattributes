# Normalise line endings to LF in the repository.
* text=auto eol=lf

# Binary assets: never diff, merge or convert line endings.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.icns   binary
*.pdf    binary
*.dmg    binary
*.zip    binary
*.woff   binary
*.woff2  binary

# Scripts must keep LF endings so they run on macOS and Linux.
*.sh     text eol=lf
Makefile text eol=lf

# GitHub language statistics: the website is not the product.
docs/**   linguist-documentation
design/** linguist-documentation
