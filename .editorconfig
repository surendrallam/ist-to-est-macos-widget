# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Swift and Python use 4 spaces (the default above). Web, data and config files use 2.
[*.{html,css,js,mjs,cjs,json,svg,xml,plist,yml,yaml,rb}]
indent_size = 2

[Brewfile]
indent_size = 2

[Makefile]
indent_style = tab

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false
