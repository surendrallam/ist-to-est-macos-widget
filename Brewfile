# Command-line tools needed to build IST to EST.
# Install them with `make bootstrap` (runs `brew bundle`). Xcode itself comes from the App Store.

brew "xcodegen"   # generates ISTtoEST.xcodeproj from project.yml
brew "swiftlint"  # `make lint`
brew "xcbeautify" # readable xcodebuild output (optional; plain output is used without it)
